# Copie para .env (na raiz do repositório) e preencha os valores.
# O mesmo arquivo é lido pelo front-end (apps/web) e pelo ETL (apps/etl).

# --- Front-end (apps/web) ---
# Só variáveis com prefixo VITE_ chegam ao navegador. Use apenas valores públicos aqui.
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# --- ETL (apps/etl) ---
# Connection string do Postgres do Supabase (Project Settings > Database), usuário postgres.
# Segredo: nunca use prefixo VITE_ nesta variável.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_ID:YOUR_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Opcionais (os valores abaixo são os padrões):
# ETL_YEARS=2026,2025,2024,2023,2022,2021,2020,2019,2018,2017
# ETL_BATCH_SIZE=5000
# ETL_DRY_RUN=0
# ETL_FORCE=0
# ETL_MAX_ROWS=      # só com ETL_DRY_RUN=1
