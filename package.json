{
  "name": "gercon-poa-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Dashboard interativo de filas de consultas GERCON - Porto Alegre (Dados Abertos 2025)",
  "type": "module",
  "scripts": {
    "dev": "vite apps/web --config apps/web/vite.config.ts",
    "build": "vue-tsc --noEmit -p apps/web/tsconfig.json && vite build apps/web --config apps/web/vite.config.ts",
    "preview": "vite preview apps/web --config apps/web/vite.config.ts",
    "etl": "tsx --tsconfig apps/etl/tsconfig.json apps/etl/index.ts",
    "etl:typecheck": "tsc --noEmit -p apps/etl/tsconfig.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "chart.js": "^4.4.8",
    "csv-parse": "^7.0.3",
    "d3": "^7.9.0",
    "drizzle-orm": "^0.45.4",
    "lucide-vue-next": "^0.475.0",
    "pg": "^8.23.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "supabase": "^3.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vite": "^6.1.1",
    "vue-tsc": "^2.2.2"
  }
}
